POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=crud
DATABASE_URL=postgres://postgres:password@db:5432/crud
# Port of the Docker db on your PC (pgAdmin and the local backend connect to localhost:5433). Containers use db:5432.
DB_HOST_PORT=5433
# Comma-separated browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Frontend build-time API URL (default: /api through the nginx / Vite proxy)
# VITE_API_URL=/api

# Dev compose (docker-compose.dev.yml) sets VITE_API_URL=http://localhost:4000/api and
# VITE_USE_POLLING=true for the web container itself; nothing to configure here.

# --- Authentication (login + per-role permissions) ---
# REQUIRED, at least 32 characters; the API refuses to start without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Session lifetime (jsonwebtoken format: 8h, 30m, 7d)
JWT_EXPIRES_IN=8h
# Set to true when the site is served over HTTPS (cookie gets the Secure flag)
COOKIE_SECURE=false
# Used by `npm run db:seed` to create the first administrator (skipped if either is empty).
# Password: 8 to 72 bytes. Change it after the first login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
# Optional: set to true to switch off the login rate limit (10 attempts / minute / IP)
# LOGIN_RATE_LIMIT_DISABLED=false
