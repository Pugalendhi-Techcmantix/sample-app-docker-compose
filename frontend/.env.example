# Base URL of the API as seen by the browser (build-time). Default: /api
# (same origin, via the Vite dev proxy or the nginx proxy in Docker).
# An absolute URL calls the backend directly and needs CORS_ORIGINS on the API.
# VITE_API_URL=http://localhost:4000/api

# Where the Vite dev server proxies /api when VITE_API_URL is unset or /api.
# API_PROXY_TARGET=http://localhost:4000

# Backend on another port (e.g. 4001)? Create a git-ignored frontend/.env.local
# (Vite gives it priority over .env.development) with, for example:
#   VITE_API_URL=http://localhost:4001/api
#   API_PROXY_TARGET=http://localhost:4001
