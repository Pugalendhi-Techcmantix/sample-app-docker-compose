# Copy to backend/.env for running the backend directly on your PC (npm start / npm run dev).
# It connects to the Docker db through the port Docker publishes on your PC (DB_HOST_PORT, 5433).
# The Docker db must be running: docker compose up -d db
# Docker does not read this file; it uses the repo-root .env.
DATABASE_URL=postgres://postgres:password@localhost:5433/crud
PORT=4001
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# --- Authentication (login + per-role permissions) ---
# REQUIRED: 32+ random characters; the API refuses to start without it (and rejects "change-me" values).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session lifetime (jsonwebtoken format: 8h, 30m, 7d)
JWT_EXPIRES_IN=8h
# Set to true when the site is served over HTTPS (cookie gets the Secure flag)
COOKIE_SECURE=false
# Used by `npm run db:seed` to create the first administrator (skipped if either is empty).
# Choose your own strong password (8 to 72 bytes; placeholders and "password"/"admin"/"12345678" are rejected).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Reverse-proxy hops to trust for X-Forwarded-For (rate limiting). 0 = none (default). Docker sets 1 for nginx.
# TRUST_PROXY=0
# Optional: set to true to switch off the login rate limit (10 attempts / minute / IP)
# LOGIN_RATE_LIMIT_DISABLED=false
